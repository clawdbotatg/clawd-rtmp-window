# Copy to .env and fill in real values. .env is gitignored.
#
# REQUIRED ----------------------------------------------------------------
# SLOP_STREAM_KEY  Full RTMP path+auth string. For slop.computer this looks
#                  like:  live?user=live&pass=<32-hex>
SLOP_STREAM_KEY="live?user=live&pass=REPLACE_ME"

# OPTIONAL ----------------------------------------------------------------
# The page captured in Chrome's --app window.
SLOP_URL="https://live.slop.computer/debug"

# god-mode password — appended as &godMode=$SLOP_GOD_MODE_PASSWORD so the
# streamer drops in without a name/sign-in. Leave unset to broadcast as
# a regular guest.
SLOP_GOD_MODE_PASSWORD=""

# RTMP server. Probably no reason to change.
RTMP_SERVER="rtmp://media.slop.computer:1935"

# Which AVFoundation display index to capture. Run `./list-devices.sh` to
# see your devices; the screens are typically indexes >= 4 (cameras come
# first). Default 4 = "Capture screen 0" = primary display.
DISPLAY_INDEX="4"

# Audio device name for system-audio loopback. Requires BlackHole or a
# similar virtual audio driver (see install.sh). Leave empty to stream
# video only.
AUDIO_DEVICE=""
# AUDIO_DEVICE="BlackHole 2ch"

# Chrome --app window placement on the captured display.
WINDOW_X="0"
WINDOW_Y="0"
WINDOW_W="1280"
WINDOW_H="720"

# Stream params.
FPS="60"
BITRATE="3400k"
